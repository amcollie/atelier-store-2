# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (Neon console > Connection Details, pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Used only by `pnpm db:studio`: a Neon dev branch or limited role, never production.
STUDIO_DATABASE_URL="postgresql://…your-branch-pooler…/neondb?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the Better Auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
